---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import SectionIndicator from "../components/layout/SectionIndicator.astro";
import Experience from "../components/sections/Experience.astro";
import Hero from "../components/sections/Hero.astro";
import Components from "../components/sections/Components.astro";
import Customizer from "../components/sections/Customizer.astro";
import Purchase from "../components/sections/Purchase.astro";
---

<BaseLayout
  title="VOLT — Precisión en cada detalle"
  description="Descubre VOLT, un concepto de teclado mecánico premium presentado mediante una experiencia interactiva en 3D."
>
  <Navbar />
  <SectionIndicator />
  <main>
    <Experience>
      <Hero />
      <Components />
      <Customizer />
      <Purchase />
    </Experience>
  </main>
  <Footer />
</BaseLayout>
